# API base URL for the Next.js server (can be an internal address)
API_URL=http://127.0.0.1:8000/api/v1
# API base URL for browsers
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public storefront origin (canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sent as X-Storefront-Key by the Next.js server (same value as the API's STOREFRONT_SERVER_KEY)
API_SERVER_KEY=
# Shared secret for POST /api/revalidate (same value as the API's STOREFRONT_REVALIDATE_SECRET)
REVALIDATE_SECRET=

# Open links to products/categories/baskets/orders in the mobile app (spec 6.6). Read at build time. Leave empty until the
# app is in the stores. Apple Team ID from developer.apple.com; Android SHA-256 signing fingerprints
# (comma-separated) from `eas credentials -p android` or Play Console > App signing.
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=
