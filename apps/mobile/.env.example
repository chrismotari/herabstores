# Copy to .env.local. Base URL of the API, including /api/v1.
# Leave unset in development to use the Expo dev server's host on port 8000
# (start the API with `php artisan serve --host 0.0.0.0`).
# Android emulator talking to a local API: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=

# The website (opens terms and conditions etc. in an in-app browser).
EXPO_PUBLIC_SITE_URL=http://localhost:3000
